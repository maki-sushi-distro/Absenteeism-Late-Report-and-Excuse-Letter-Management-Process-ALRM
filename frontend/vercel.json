{
  "headers": [
    {
      "source": "/((?!$|login/?$|assets/|LV_Logo[.]png$|robots[.]txt$|sitemap[.]xml$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://absenteeism-late-report-and-excuse.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
